#!/bin/sh
# Validate the exact index Git will commit, including path-limited commit indexes.
# Existing marketplace/blueprint gates run in a temporary snapshot.
# Unstaged and untracked work stays untouched and cannot hide stale staged mirrors.
# Enable once per clone: git config core.hooksPath scripts/hooks
# Deliberate bypass: git commit --no-verify

exec node "$(dirname "$0")/../validate-staged.mjs"
